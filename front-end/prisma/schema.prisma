datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Developer {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  slug        String     @unique
  logo        String?
  description String?
  compounds   Compound[]
  properties  Property[]
}

model Location {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  slug       String     @unique
  mapUrl     String?
  compounds  Compound[]
  properties Property[]
}

model Amenity {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  compounds  Compound[]
  properties Property[]
}

model Compound {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  slug         String     @unique
  developerId  Int
  developer    Developer  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  locationId   Int?
  location     Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  mainImage    String?
  description  String?
  status       String?
  deliveryDate String?
  amenities    Amenity[]
  properties   Property[]
}

model Property {
  id             Int             @id @default(autoincrement())
  title          String
  slug           String          @unique
  compoundId     Int?
  compound       Compound?       @relation(fields: [compoundId], references: [id], onDelete: SetNull)
  developerId    Int?
  developer      Developer?      @relation(fields: [developerId], references: [id], onDelete: SetNull)
  locationId     Int?
  location       Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  propertyType   String
  price          Decimal
  area           Int
  bedrooms       Int
  bathrooms      Int
  description    String
  mainImage      String?
  floorPlanImage String?
  mapImage       String?
  isNewLaunch    Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  amenities      Amenity[]
  galleryImages  PropertyImage[]
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  image      String
  altText    String?
}

model Author {
  id      Int        @id @default(autoincrement())
  name    String
  picture String?
  posts   BlogPost[]
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  publishDate DateTime @default(now())
  authorId    Int?
  author      Author?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  image       String?
  status      String   @default("Draft")
}

model Partner {
  id   Int    @id @default(autoincrement())
  name String
  logo String
}

model Testimonial {
  id           Int     @id @default(autoincrement())
  clientName   String
  clientAvatar String?
  rating       Int
  quote        String
}

model ContactFormSubmission {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  message     String
  submittedAt DateTime @default(now())
}

// NextAuth.js Models for Authentication
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("ADMIN") // Basic RBAC
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
